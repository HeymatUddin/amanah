# Copy to backend/.env. Keep real credentials private.
MONGODB_URI=mongodb://127.0.0.1:27017
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Used only by scripts/create-admin.js.
# Create an enabled Firebase Authentication user first and copy its UID.
ADMIN_FIREBASE_UID=replace_with_your_firebase_user_uid
ADMIN_FIRST_NAME=YourFirstName
ADMIN_LAST_NAME=YourLastName
